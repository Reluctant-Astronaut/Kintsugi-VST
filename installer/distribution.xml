<?xml version="1.0" encoding="utf-8"?>
<installer-gui-script minSpecVersion="2">
    <title>Kintsugi</title>
    <organization>com.reluctantastronaut</organization>
    <welcome file="welcome.html" mime-type="text/html"/>
    <conclusion file="conclusion.html" mime-type="text/html"/>
    <options customize="allow" require-scripts="false" hostArchitectures="arm64,x86_64"/>
    <domains enable_anywhere="false" enable_currentUserHome="false" enable_localSystem="true"/>
    <choices-outline>
        <line choice="vst3"/>
        <line choice="au"/>
    </choices-outline>
    <choice id="vst3" title="Kintsugi VST3"
            description="For Cubase, Ableton Live, Reaper, Studio One, Bitwig and most other music programs."
            start_selected="true">
        <pkg-ref id="com.reluctantastronaut.kintsugi.vst3"/>
    </choice>
    <choice id="au" title="Kintsugi Audio Unit"
            description="For Logic Pro and GarageBand."
            start_selected="true">
        <pkg-ref id="com.reluctantastronaut.kintsugi.au"/>
    </choice>
    <pkg-ref id="com.reluctantastronaut.kintsugi.vst3" version="1.0.0" onConclusion="none">Kintsugi-VST3.pkg</pkg-ref>
    <pkg-ref id="com.reluctantastronaut.kintsugi.au" version="1.0.0" onConclusion="none">Kintsugi-AU.pkg</pkg-ref>
</installer-gui-script>
